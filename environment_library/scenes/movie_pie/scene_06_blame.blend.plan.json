 "lines": [
  {
   "k": 0,
   "speaker": "orin",
   "to": "gus",
   "mood": "angry",
   "text": "Gus! You were sniffing the pie. I heard it from the anvil.",
   "t0": 5.245,
   "t1": 8.866768707482994
  },
  {
   "k": 1,
   "speaker": "gus",
   "to": "orin",
   "mood": "angry",
   "text": "I only sniffed! I would never take it.",
   "t0": 9.078333333333333,
   "t1": 11.325
  },
  {
   "k": 2,
   "speaker": "tilda",
   "to": "gus",
   "mood": "sad",
   "text": "Nobody else loves pie like you, Gus.",
   "t0": 17.62,
   "t1": 20.80172335600907
  },
  {
   "k": 3,
   "speaker": "gus",
   "to": "tilda",
   "mood": "angry",
   "text": "This is a terrible thing to say about a blacksmith!",
   "t0": 20.995,
   "t1": 23.742573696145126
  },
  {
   "k": 4,
   "speaker": "rosa",
   "to": "orin",
   "mood": "concern",
   "text": "Wait. Look. Small footprints in the dust. Little ones. Going east.",
   "t0": 35.03666666666666,
   "t1": 41.23190476190476
  },
  {
   "k": 5,
   "speaker": "gus",
   "to": "rosa",
   "mood": "concern",
   "text": "Small! Do I look small?",
   "t0": 41.41166666666666,
   "t1": 43.231530612244896
  },
  {
   "k": 6,
   "speaker": "orin",
   "to": "tilda",
   "mood": "serious",
   "text": "Follow them! The contest is at noon.",
   "t0": 43.41166666666666,
