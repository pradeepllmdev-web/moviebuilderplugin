 "lines": [
  {
   "k": 0,
   "speaker": "tilda",
   "to": "fen",
   "mood": "warm",
   "text": "Three days without food. And you still left half for the sheep.",
   "t0": 4.87,
   "t1": 8.55748299319728
  },
  {
   "k": 1,
   "speaker": "fen",
   "to": "tilda",
   "mood": "warm",
   "text": "Only half. The rest is for Pip.",
   "t0": 8.745,
   "t1": 11.41080498866213
  },
  {
   "k": 2,
   "speaker": "tilda",
   "to": "pip",
   "mood": "warm",
   "text": "Pip, a pie is for eating. Next time, just ask.",
   "t0": 15.62,
   "t1": 18.947573696145124
  },
  {
   "k": 3,
   "speaker": "pip",
   "to": "tilda",
   "mood": "joy",
   "text": "Yes, Miss Tilda.",
   "t0": 19.16166666666667,
   "t1": 20.422664399092973
  },
  {
   "k": 4,
   "speaker": "gus",
   "to": "fen",
   "mood": "joy",
   "text": "I will fetch your sheep, old man. They are afraid of nothing but my hammer.",
   "t0": 28.62,
   "t1": 32.60154195011338
  },
  {
   "k": 5,
   "speaker": "orin",
   "to": "tilda",
   "mood": "joy",
   "text": "Then come to the square, everyone! The contest goes on!",
