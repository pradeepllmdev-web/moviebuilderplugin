 "lines": [
  {
   "k": 0,
   "speaker": "mina",
   "to": "mina",
   "mood": "joy",
   "text": "A golden key, lying on the flat rock. Maybe it opens a treasure chest!",
   "t0": 7.953333333333333,
   "t1": 13.405532879818594
  },
  {
   "k": 1,
   "speaker": "joss",
   "to": "mina",
   "mood": "concern",
   "text": "Mina! That is no toy. That is the key to the clock tower.",
   "t0": 17.53666666666667,
   "t1": 21.758208616780045
  },
  {
   "k": 2,
   "speaker": "mina",
   "to": "joss",
   "mood": "concern",
   "text": "The clock stopped this morning. Somebody must be so worried!",
   "t0": 21.953333333333333,
   "t1": 25.47827664399093
  },
  {
   "k": 3,
   "speaker": "joss",
   "to": "mina",
   "mood": "warm",
   "text": "We will take it back together.",
   "t0": 30.03666666666667,
   "t1": 31.495034013605444
  },
  {
   "k": 4,
   "speaker": "mina",
   "to": "joss",
   "mood": "joy",
   "text": "I will carry it. I found it!",
