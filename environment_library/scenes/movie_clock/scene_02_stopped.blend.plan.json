 "lines": [
  {
   "k": 0,
   "speaker": "nell",
   "to": "ada",
   "mood": "concern",
   "text": "Granny Ada, the clock has stopped! It still says half past six.",
   "t0": 3.7866666666666666,
   "t1": 8.262947845804987
  },
  {
   "k": 1,
   "speaker": "ada",
   "to": "nell",
   "mood": "warm",
   "text": "It is nearly nine, Nell. Did you wind it this morning?",
   "t0": 8.453333333333333,
   "t1": 11.714920634920635
  },
  {
   "k": 2,
   "speaker": "nell",
   "to": "ada",
   "mood": "sad",
   "text": "I was about to... oh no. My key is not on my belt.",
   "t0": 11.911666666666665,
   "t1": 16.82082766439909
  },
  {
   "k": 3,
   "speaker": "pol",
   "to": "nell",
   "mood": "concern",
   "text": "Where did you last have it?",
   "t0": 20.53666666666667,
   "t1": 21.997709750566894
  },
  {
   "k": 4,
   "speaker": "nell",
   "to": "pol",
   "mood": "concern",
   "text": "At the stream. I set it on the flat rock while I washed my hands.",
   "t0": 22.203333333333333,
   "t1": 26.931451247165533
  },
  {
   "k": 5,
   "speaker": "pol",
   "to": "nell",
   "mood": "warm",
   "text": "Then the rock is where we start. Go, we will keep the village calm.",
   "t0": 31.62,
   "t1": 35.08253968253968
  },
  {
   "k": 6,
   "speaker": "nell",
   "to": "pol",
   "mood": "warm",
   "text": "Thank you, both. I will be quick!",
   "t0": 35.56666666666666,
   "t1": 37.276666666666664
  }
 ],
