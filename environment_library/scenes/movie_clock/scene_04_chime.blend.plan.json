 "lines": [
  {
   "k": 0,
   "speaker": "mina",
   "to": "nell",
   "mood": "joy",
   "text": "Miss Nell? Is this what you are looking for? It was on the flat rock.",
   "t0": 0.4,
   "t1": 4.551882086167801
  },
  {
   "k": 1,
   "speaker": "nell",
   "to": "mina",
   "mood": "joy",
   "text": "My key! Mina, you wonderful girl. I thought the whole village was lost to time.",
   "t0": 9.078333333333333,
   "t1": 14.213843537414967
  },
  {
   "k": 2,
   "speaker": "joss",
   "to": "nell",
   "mood": "joy",
   "text": "She would not let me carry it once.",
   "t0": 14.411666666666665,
   "t1": 16.71756235827664
  },
  {
   "k": 3,
   "speaker": "pol",
   "to": "nell",
   "mood": "warm",
   "text": "An honest soul picked it up. We have a few of those.",
   "t0": 16.91166666666667,
   "t1": 19.9693537414966
  },
  {
   "k": 4,
   "speaker": "ada",
   "to": "nell",
   "mood": "warm",
   "text": "Or a magpie. They do love anything shiny.",
   "t0": 20.16166666666667,
   "t1": 23.875498866213153
  },
  {
   "k": 5,
   "speaker": "nell",
   "to": "pol",
   "mood": "warm",
   "text": "Stand back, everyone. Time to wake up the clock.",
   "t0": 27.85833333333333,
   "t1": 31.31910430839002
  },
  {
   "k": 6,
   "speaker": "pol",
   "to": "nell",
   "mood": "joy",
   "text": "Right on time. My bread thanks you, Nell!",
   "t0": 37.53666666666666,
   "t1": 40.23349206349206
  }
 ],
