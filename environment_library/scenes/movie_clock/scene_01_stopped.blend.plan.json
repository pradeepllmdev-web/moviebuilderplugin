 "lines": [
  {
   "k": 0,
   "speaker": "pol",
   "to": "ada",
   "mood": "concern",
   "text": "Half past six. Again. My bread will burn if I miss the bell.",
   "t0": 1.2033333333333331,
   "t1": 5.368458049886621
  },
  {
   "k": 1,
   "speaker": "ada",
   "to": "pol",
   "mood": "concern",
   "text": "Look at the tower. The clock has stopped at the wrong hour.",
   "t0": 10.828333333333333,
   "t1": 14.179126984126984
  },
  {
   "k": 2,
   "speaker": "nell",
   "to": "pol",
   "mood": "sad",
   "text": "The key! I have lost the winding key. It was on my belt this morning.",
   "t0": 17.203333333333333,
   "t1": 21.95408163265306
  },
  {
   "k": 3,
   "speaker": "pol",
   "to": "nell",
   "mood": "warm",
   "text": "Then we must find it before noon.",
   "t0": 22.16166666666667,
   "t1": 24.130873015873018
  }
