 "lines": [
  {
   "k": 0,
   "speaker": "pol",
   "to": "mina",
   "mood": "warm",
   "text": "This one is for you, Mina. Still warm from the oven.",
   "t0": 4.108333333333333,
   "t1": 7.087607709750567
  },
  {
   "k": 1,
   "speaker": "mina",
   "to": "pol",
   "mood": "joy",
   "text": "For me? It smells like cinnamon. Thank you, Pol!",
   "t0": 13.161666666666665,
   "t1": 16.245430839002267
  },
  {
   "k": 2,
   "speaker": "joss",
   "to": "pol",
   "mood": "joy",
   "text": "Not a bad morning, Pol. Mina found a key, and I found an excuse for a second breakfast.",
   "t0": 17.53666666666667,
   "t1": 22.07167800453515
  },
  {
   "k": 3,
   "speaker": "pol",
   "to": "joss",
   "mood": "warm",
   "text": "And I found a reason to bake a bigger batch tomorrow.",
   "t0": 22.28666666666667,
   "t1": 24.858231292517008
  },
  {
   "k": 4,
   "speaker": "ada",
   "to": "nell",
   "mood": "warm",
   "text": "Noon on the dot, Nell. It was almost worth the fright.",
   "t0": 26.16166666666667,
   "t1": 29.719716553287984
  },
  {
   "k": 5,
   "speaker": "nell",
   "to": "ada",
   "mood": "joy",
   "text": "Never again. Tonight I tie that key to my belt with a double knot.",
   "t0": 29.91166666666667,
   "t1": 34.755702947845805
  }
 ],
